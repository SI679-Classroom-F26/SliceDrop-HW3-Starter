# Copy this file to .env and replace the value below with your own secret.
# .env is in .gitignore: it never goes to GitHub. This file does, which is
# why it holds a placeholder rather than a real secret.
#
# One way to make a good secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET="replace-me-with-a-long-random-string"
